{
  "name": "effect-api-query",
  "version": "0.1.0",
  "description": "Type-safe TanStack Query utilities derived from Effect RPC and HTTP API contracts.",
  "keywords": [
    "tanstack-intent"
  ],
  "homepage": "https://github.com/ueberBrot/effect-api-query#readme",
  "bugs": {
    "url": "https://github.com/ueberBrot/effect-api-query/issues"
  },
  "license": "ISC",
  "author": "Maurice de Bruyn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueberBrot/effect-api-query.git"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "imports": {
    "#effect-api-query": "./src/index.ts",
    "#effect-api-query/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "changeset": "changeset",
    "prepare": "vp config --no-agent && effect-tsgo patch --typescript --oxlint",
    "version-packages": "changeset version && vp fmt"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@changesets/config": "4.0.1",
    "@effect-api-query/contracts": "workspace:*",
    "@effect-api-query/server": "workspace:*",
    "@effect/tsgo": "0.47.2",
    "@effect/vitest": "4.0.0",
    "@playwright/test": "1.63.0",
    "@shadcn/lint": "0.2.0",
    "@tanstack/intent": "0.5.0",
    "@tanstack/query-core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@types/node": "24.19.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "fallow": "3.31.0",
    "oxlint": "1.85.0",
    "publint": "0.3.24",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-5.9": "npm:typescript@5.9.3",
    "ultracite": "7.12.2",
    "unplugin-unused": "0.6.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/query-core": ">=5.103.1 <6",
    "effect": "catalog:"
  },
  "packageManager": "pnpm@12.8.2"
}
