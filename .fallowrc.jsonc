{
  "$schema": "./node_modules/fallow/schema.json",

  "entry": [
    "scripts/measure-construction.mts",
    "scripts/check-framework-consumers.mts",
    "scripts/measure-bundles.mts",
    "scripts/measure-streams.mts",
    "scripts/measure-types.mts",
    "scripts/resolve-docs-release.mts",
    "playwright.docs.config.ts",
    "tests/types/*.{ts,tsx}",
  ],

  "ignorePatterns": [
    "examples/tanstack-start/src/routeTree.gen.ts",
    "tests/framework-consumers/**",
  ],

  "ignoreExports": [
    {
      "file": "apps/docs/astro.config.mts",
      "exports": ["default"],
    },
    {
      "file": "playwright.config.ts",
      "exports": ["default"],
    },
    {
      "file": "playwright.docs.config.ts",
      "exports": ["default"],
    },
    {
      "file": "examples/tanstack-start/src/router.tsx",
      "exports": ["getRouter"],
    },
  ],

  "duplicates": {
    "mode": "semantic",
    "near": true,
  },

  "ignoreDependencies": [
    "@arethetypeswrong/cli",
    "@effect/platform-node",
    "@effect/tsgo",
    "@effect/vitest",
    "@shadcn/lint",
    "@tanstack/intent",
    "effect",
    // Fallow resolves workspace imports to source but misses the root package dependency.
    "@ueberbrot/effect-api-query",
    "publint",
    // React belongs to the private apps; Fallow attributes shared example sources to the root.
    "react",
    "typescript-5.9",
    "unplugin-unused",
  ],

  "health": {
    "ignore": [
      "apps/**",
      "docs/**",
      "e2e/**",
      "e2e-docs/**",
      "examples/**",
      "scripts/**",
      "tests/**",
      "*.config.*",
    ],
  },

  "rules": {
    "private-type-leaks": "error",

    "stale-suppressions": "off",
  },

  "overrides": [
    {
      "files": ["src/index.ts"],
      "rules": { "unused-types": "off" },
    },
  ],
}
