{
  "$schema": "./node_modules/fallow/schema.json",

  // Astro copies this browser entry from public/ and loads it through the
  // Starlight head configuration, which static import analysis cannot follow.
  "entry": [
    "scripts/verify-vue-solid-consumer.mts",
    "tests/packed-consumer/docs-vue-query.ts",
    "tests/packed-consumer/docs-solid-query.ts",
    "tests/packed-consumer/vue-solid-contract.ts",
    "tests/packed-consumer/vue-solid-runtime.ts",
    "tests/packed-consumer/owner-cache-runtime.mts",
    "tests/packed-consumer/start-ssr-runtime.mts",
    "tests/packed-consumer/owner-cache-contract.ts",
    "apps/docs/public/package-version.js",
    "playwright.docs.config.ts",
    "tests/packed-consumer/hashing-runtime.mts",
    "tests/packed-consumer/optimistic-runtime.mts",
    "tests/packed-consumer/optimistic-contract.ts",
    "tests/packed-consumer/events-runtime.mts",
    "tests/packed-consumer/events-contract.ts",
    "tests/packed-consumer/filter-runtime.mts",
    "tests/packed-consumer/filter-contract.ts",
    "tests/packed-consumer/http-metadata-runtime.mts",
    "tests/packed-consumer/openapi-contract.ts",
    "tests/packed-consumer/openapi-runtime.mts",
    "tests/packed-consumer/openapi-generate.mjs",
    "tests/packed-consumer/docs-openapi.ts",
    "tests/packed-consumer/http-etag-recipe.mts",
    "tests/packed-consumer/http-stream-runtime.mts",
    "tests/packed-consumer/http-live-runtime.mts",
    "tests/packed-consumer/stream-cause-runtime.mts",
    "tests/packed-consumer/stream-policy-runtime.mts",
    "tests/packed-consumer/retry-runtime.mts",
    "tests/packed-consumer/snapshot-runtime.mts",
    "tests/packed-consumer/snapshot-contract.ts",
    "tests/packed-consumer/defaults-runtime.mts",
    "tests/packed-consumer/defaults-contract.ts",
    "scripts/verify-svelte-angular-consumer.mts",
    "tests/packed-consumer/svelte-angular-runtime.ts",
    "tests/packed-consumer/svelte-angular-contract.ts",
    "tests/packed-consumer/docs-angular.ts",
    "tests/packed-consumer/hydration-runtime.mts",
    "tests/packed-consumer/hydration-views-runtime.mts",
    "tests/packed-consumer/hydration-contract.ts",
    "tests/packed-consumer/hosts/browser.ts",
    "tests/packed-consumer/hosts/worker.ts"
  ],

  "ignorePatterns": ["examples/tanstack-start/src/routeTree.gen.ts"],
  "ignoreUnresolvedImports": ["./openapi-generated.ts"],

  // Framework tooling consumes these exports through convention-generated entries.
  "ignoreExports": [
    {
      "file": "apps/docs/astro.config.mjs",
      "exports": ["default"]
    },
    {
      "file": "playwright.config.ts",
      "exports": ["default"]
    },
    {
      "file": "playwright.docs.config.ts",
      "exports": ["default"]
    },
    {
      "file": "examples/tanstack-start/src/router.tsx",
      "exports": ["getRouter"]
    }
  ],

  // Each executable example keeps its resource ownership and cancellation
  // workflow and UI in place so readers can understand and copy the integration.
  // Fingerprints expire when the duplicated code or occurrence count changes.
  "duplicates": {
    "ignoredClones": [
      "dup:22704c46:2",
      "dup:3fec4231:2",
      "dup:91b44e3a:2",
      "dup:c77b3abb6f87acd9-10:2",
      "dup:c77b3abb6f87acd9-11:2",
      "dup:c77b3abb6f87acd9-12:2",
      "dup:c77b3abb6f87acd9-13:2",
      "dup:c77b3abb6f87acd9-14:2",
      "dup:c77b3abb6f87acd9-15:2",
      "dup:c77b3abb6f87acd9-16:2",
      "dup:c77b3abb6f87acd9-1:2",
      "dup:c77b3abb6f87acd9-2:2",
      "dup:c77b3abb6f87acd9-3:2",
      "dup:c77b3abb6f87acd9-4:2",
      "dup:c77b3abb6f87acd9-5:2",
      "dup:c77b3abb6f87acd9-6:2",
      "dup:c77b3abb6f87acd9-7:2",
      "dup:c77b3abb6f87acd9-8:2",
      "dup:c77b3abb6f87acd9-9:2"
    ]
  },

  // Vite+ tasks, packing, and imported lint presets invoke tools Fallow cannot trace.
  // Keep Effect peer and test dependencies available for the library and fixtures.
  "ignoreDependencies": [
    "@angular/compiler",
    "@angular/core",
    "@angular/platform-browser",
    "@tanstack/solid-query",
    "@tanstack/vue-query",
    "solid-js",
    "vue",
    "@arethetypeswrong/cli",
    "@effect/tsgo",
    "@effect/vitest",
    "@effect/platform-node",
    "@shadcn/lint",
    "@tanstack/angular-query-experimental",
    "@tanstack/svelte-query",
    "effect",
    "openapi-fetch",
    "openapi-typescript",
    "publint",
    "svelte",
    "typescript-5.9",
    "unplugin-unused"
  ],

  // Health measures shipped library code in src/. Exclude docs, examples,
  // tooling, and tests here; other audits retain their repository-wide scope.
  "health": {
    "ignore": [
      "apps/**",
      "docs/**",
      "e2e/**",
      "e2e-docs/**",
      "examples/**",
      "scripts/**",
      "tests/**",
      "*.config.*"
    ]
  },

  "rules": {
    "private-type-leaks": "error",

    // Public-entry suppressions are valid in the entry audit but necessarily
    // look stale in production mode, where package entry exports are exempt.
    "stale-suppressions": "off"
  }
}
