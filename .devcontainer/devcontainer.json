{
  "name": "effect-api-query",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "mounts": [
    "source=effect-api-query-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=effect-api-query-pnpm-store,target=/home/node/.local/share/pnpm/store,type=volume",
    "source=effect-api-query-tool-cache,target=/home/node/.cache,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/node_modules/.bin:${containerEnv:PATH}"
  },
  "forwardPorts": [3000, 3001, 4173, 5173],
  "portsAttributes": {
    "3000": {
      "label": "TanStack Start application",
      "onAutoForward": "openPreview"
    },
    "3001": {
      "label": "Effect RPC server",
      "onAutoForward": "silent"
    },
    "4173": {
      "label": "Vite React production preview",
      "onAutoForward": "openPreview"
    },
    "5173": {
      "label": "Vite React development application",
      "onAutoForward": "openPreview"
    }
  }
}
