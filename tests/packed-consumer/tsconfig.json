{
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "construction-baseline.mts",
    "owner-cache.ts",
    "docs-owner-cache.ts",
    "owner-cache-contract.ts",
    "owner-cache-runtime.mts",
    "start-ssr-runtime.mts",
    "optimistic-runtime.mts",
    "optimistic-contract.ts",
    "events-runtime.mts",
    "socket-client.ts",
    "docs-websocket-use.ts",
    "websocket-checks.ts",
    "websocket-server.ts",
    "websocket-runtime.mts",
    "events-contract.ts",
    "docs-user-events.ts",
    "user-events.ts",
    "hashing-runtime.mts",
    "filter-runtime.mts",
    "filter-contract.ts",
    "docs-cache-filters-*.ts",
    "runtime.mts",
    "stream-cause-runtime.mts",
    "stream-policy-runtime.mts",
    "retry-runtime.mts",
    "snapshot-runtime.mts",
    "snapshot-contract.ts",
    "defaults-runtime.mts",
    "defaults-contract.ts",
    "docs-defaults.ts",
    "docs-http-defaults.ts",
    "hydration-runtime.mts",
    "hydration-views-runtime.mts",
    "hydration-views-contract.ts",
    "http-runtime.mts",
    "http-metadata-runtime.mts",
    "http-etag-recipe.mts",
    "http-stream-runtime.mts",
    "http-live-runtime.mts",
    "http-stream-contract.ts",
    "public-contract.ts",
    "http-contract.ts",
    "hosts/**/*.ts",
    "docs-rpc-quick-start.ts",
    "docs-http-quick-start.ts",
    "docs-retry.ts",
    "docs-stream-snapshot.ts",
    "docs-hydration-*.ts",
    "hydration-contract.ts",
    "skill-example-*.ts"
  ]
}
