{
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "hashing-runtime.mts",
    "runtime.mts",
    "stream-cause-runtime.mts",
    "stream-policy-runtime.mts",
    "retry-runtime.mts",
    "defaults-runtime.mts",
    "defaults-contract.ts",
    "docs-defaults.ts",
    "docs-http-defaults.ts",
    "hydration-runtime.mts",
    "http-runtime.mts",
    "http-metadata-runtime.mts",
    "http-etag-recipe.mts",
    "http-stream-runtime.mts",
    "http-live-runtime.mts",
    "http-stream-contract.ts",
    "public-contract.ts",
    "http-contract.ts",
    "docs-rpc-quick-start.ts",
    "docs-http-quick-start.ts",
    "docs-retry.ts",
    "docs-hydration-*.ts",
    "hydration-contract.ts",
    "skill-example-*.ts"
  ]
}
